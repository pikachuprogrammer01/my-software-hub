{
  "name": "my-software-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "名下所有产品的对外门户与文档站（内容源为 markdown；数据面在 my-software-releases）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/validate-contract.mjs && node scripts/content-validate.mjs && node scripts/content-build.mjs && node scripts/content-lint.mjs && vitepress build",
    "preview": "vitepress preview",
    "validate": "node scripts/validate-contract.mjs && node scripts/content-validate.mjs && node scripts/content-build.mjs && node scripts/content-drift.mjs && node scripts/content-lint.mjs && node scripts/lint-shell.mjs && node scripts/test-content.mjs",
    "validate:strict": "node scripts/validate-contract.mjs --strict",
    "verify": "node scripts/verify.mjs",
    "sync": "node scripts/sync-release.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "content:build": "node scripts/content-build.mjs",
    "content:drift": "node scripts/content-drift.mjs",
    "content:lint": "node scripts/content-lint.mjs",
    "content:publish": "node scripts/content-publish.mjs",
    "content:rollback": "node scripts/content-rollback.mjs",
    "test:content": "node scripts/test-content.mjs",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node .server-dist/index.js",
    "api:openapi": "node scripts/export-openapi.mjs",
    "proposal:review": "node scripts/proposal-review.mjs",
    "deploy:package": "node deploy/package.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:deploy": "node scripts/test-deploy.mjs",
    "verify:full": "node scripts/verify.mjs --with-deploy",
    "conformance:fixtures": "node scripts/conformance-fixtures.mjs",
    "test:conformance": "node scripts/test-conformance.mjs",
    "test:proposal": "node scripts/test-proposal-review.mjs",
    "lint:shell": "node scripts/lint-shell.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12"
  }
}
