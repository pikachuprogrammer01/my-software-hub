{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitee.com/pikachuprogrammer01/my-software-releases/schema/proposal-envelope.v1.json",
  "title": "content proposal envelope v1",
  "description": "提案 API 的请求信封。它包住冻结的 proposal.v1 本体，额外携带冲突检测所需的基础 revision 与字段旧值；proposal.v1 本身不改形态。",
  "type": "object",
  "required": ["proposal"],
  "additionalProperties": false,
  "properties": {
    "proposal": { "$ref": "https://gitee.com/pikachuprogrammer01/my-software-releases/schema/proposal.v1.json" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "description": "客户端提交时所见的基线。缺失时提案仍可接收，但服务端无法判定字段级冲突。",
      "properties": {
        "contentRevision": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "currentValue": {}
      }
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "description": "提交身份声明。这是自报信息，不构成安全边界；可信与否由服务端凭证判定。",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "device": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
