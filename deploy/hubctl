#!/usr/bin/env bash
# my-software-hub 手机侧运维入口（Android + Termux，也在 macOS/Linux 上可用）
# 约定：不依赖 Docker、systemd、VitePress dev/preview；手机上不装开发依赖、不构建站点。
set -euo pipefail

HUB_HOME="${HUB_HOME:-$HOME/hub}"
HUB_ENV_FILE="$HUB_HOME/hub.env"
RELEASES_DIR="$HUB_HOME/releases"
CURRENT_LINK="$HUB_HOME/current"
HISTORY_FILE="$HUB_HOME/release-history"

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8787}"
HUB_DATA_DIR="${HUB_DATA_DIR:-$HUB_HOME/data}"
LOG_FILE="$HUB_DATA_DIR/logs/hubd.log"
PID_FILE="$HUB_DATA_DIR/run/hubd.pid"
LOG_MAX_BYTES="${LOG_MAX_BYTES:-2097152}"
LOG_KEEP="${LOG_KEEP:-5}"

usage() {
  cat <<'EOF'
用法：hubctl <命令> [参数]

  install <package.tar.gz|目录>   校验并安装部署包（设备侧装依赖 → 先备份 → 迁移 → 健康检查 → 切换）
  start                           前台守卫式启动（后台 nohup + pid 文件），健康检查通过才算成功
  stop                            优雅停止（SIGTERM，等待数据库关闭与 WAL checkpoint）
  status                          进程/端口/健康/版本/数据库统计
                                  配置优先级：显式导出的环境变量 > hub.env > 默认值
  logs [-n 行数]                  查看服务日志（自动轮转，保留 5 份）
  backup [--out 文件]             SQLite 在线一致性备份 + sha256 + 统计元数据
  restore --from <备份> [--force] 先校验再替换；迁移不兼容时拒绝并给恢复步骤
  rollback [版本]                 回退上一个部署包；数据库不做危险降级
  doctor                          设备/依赖/路径/健康自检
  env                             打印当前生效配置（不含任何凭证值）

安装前置（Termux）：
  pkg update && pkg install nodejs make clang python3 binutils
  依赖必须在设备上编译；不要把电脑上的 node_modules 拷进手机。
EOF
}

log()  { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"; }
warn() { printf '%s WARN %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2; }
die()  { printf '%s ERROR %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2; exit 1; }

apply_env_file() {
  if [ -f "$HUB_ENV_FILE" ]; then
    # 只允许配置运行参数；文件里不该出现任何密钥值（密钥应放 *_TOKEN_FILE 指向的私有文件）
    # 优先级：调用方显式导出的环境变量 > hub.env > 内置默认值
    local line key value
    while IFS= read -r line; do
      case "$line" in ''|\#*) continue ;; esac
      key="${line%%=*}"
      value="${line#*=}"
      [ "$key" = "$line" ] && continue
      if [ -z "${!key:-}" ]; then
        export "$key=$value"
      fi
    done < "$HUB_ENV_FILE"
  fi
  HOST="${HOST:-127.0.0.1}"
  PORT="${PORT:-8787}"
  HUB_DATA_DIR="${HUB_DATA_DIR:-$HUB_HOME/data}"
  LOG_FILE="$HUB_DATA_DIR/logs/hubd.log"
  PID_FILE="$HUB_DATA_DIR/run/hubd.pid"
}

require_dirs() {
  mkdir -p "$HUB_HOME" "$RELEASES_DIR" "$HUB_DATA_DIR/db" "$HUB_DATA_DIR/logs" "$HUB_DATA_DIR/run" "$HUB_DATA_DIR/backups"
}

current_dir() {
  [ -L "$CURRENT_LINK" ] || return 1
  readlink "$CURRENT_LINK" 2>/dev/null || python -c 'import os;print(os.readlink("'"$CURRENT_LINK"'"))' 2>/dev/null || readlink -f "$CURRENT_LINK"
}

current_version() {
  local dir
  dir="$(current_dir)" || return 1
  basename "$dir" | sed 's/^hub-//'
}

health_ok() {
  local port="${1:-$PORT}"
  node -e '
const [, port] = process.argv
fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(3000) })
  .then((res) => res.ok ? res.json() : Promise.reject(new Error("HTTP " + res.status)))
  .then((body) => { if (body.status !== "ok") throw new Error("status=" + body.status); process.exit(0) })
  .catch(() => process.exit(1))
' "$port" 2>/dev/null
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s' "$pid"
}

rotate_logs() {
  [ -f "$LOG_FILE" ] || return 0
  local size
  size="$(wc -c < "$LOG_FILE" | tr -d ' ')"
  [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] || return 0
  local i
  i="$LOG_KEEP"
  while [ "$i" -gt 1 ]; do
    local prev=$((i - 1))
    [ -f "$LOG_FILE.$prev" ] && mv "$LOG_FILE.$prev" "$LOG_FILE.$i"
    i="$prev"
  done
  mv "$LOG_FILE" "$LOG_FILE.1"
  log "日志已轮转（${size} 字节 → $LOG_FILE.1）"
}

do_start() {
  apply_env_file
  require_dirs
  local release
  release="$(current_dir || true)"
  [ -n "$release" ] || die "尚未安装部署包：hubctl install <package.tar.gz>"

  if pid="$(running_pid)"; then
    warn "服务已在运行（pid=$pid），不重复启动"
    return 0
  fi
  rotate_logs
  log "启动 $release（HOST=$HOST PORT=$PORT）"
  (
    cd "$release"
    HUB_DATA_DIR="$HUB_DATA_DIR" HUB_STATIC_DIR="$release/site" HUB_CONTENT_DIR="$release/runtime/data/generated" \
    HUB_SCHEMA_DIR="$release/schema" HUB_MIGRATIONS_DIR="$release/migrations" \
    HUB_VERSION="$(basename "$release" | sed 's/^hub-//')" HOST="$HOST" PORT="$PORT" \
    nohup node "$release/api/index.js" >> "$LOG_FILE" 2>&1 &
  )
  local waited=0
  while [ "$waited" -lt 20 ]; do
    if health_ok; then
      log "✅ 启动成功：http://${HOST}:${PORT}/health（pid=$(running_pid || echo '?')）"
      [ "$HOST" = "0.0.0.0" ] && warn "监听 0.0.0.0：同一局域网内的设备可访问，请确认这是你想要的暴露范围"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  warn "健康检查未在 ${waited}s 内通过，最后 30 行日志："
  tail -n 30 "$LOG_FILE" >&2 || true
  die "启动失败：日志见 $LOG_FILE"
}

do_stop() {
  apply_env_file
  local pid
  if ! pid="$(running_pid)"; then
    log "服务未在运行"
    [ -f "$PID_FILE" ] && rm -f "$PID_FILE"
    return 0
  fi
  log "发送 SIGTERM 给 pid=$pid（优雅关闭会 checkpoint WAL）"
  kill -TERM "$pid"
  local waited=0
  while [ "$waited" -lt 15 ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    warn "pid=$pid 未在 ${waited}s 内退出，发送 SIGKILL（数据库可能未 checkpoint，建议随后执行 backup verify）"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  log "✅ 已停止"
}

verify_manifest() {
  local release="$1"
  [ -f "$release/manifest.json" ] || die "缺少 manifest.json"
  if [ -f "$release/manifest.sha256" ]; then
    ( cd "$release" && node -e '
      const fs=require("fs"),crypto=require("crypto")
      const [line]=fs.readFileSync("manifest.sha256","utf8").split("\n")
      const expected=(line||"").trim().split(/\s+/)[0]
      const actual=crypto.createHash("sha256").update(fs.readFileSync("manifest.json")).digest("hex")
      if(expected!==actual){console.error("manifest.json 与 manifest.sha256 不一致");process.exit(1)}
    ' ) || die "manifest 校验和不一致"
  fi
  ( cd "$release" && node -e '
    const fs=require("fs"),crypto=require("crypto")
    const manifest=JSON.parse(fs.readFileSync("manifest.json","utf8"))
    let bad=0
    for (const entry of manifest.files) {
      if(!fs.existsSync(entry.path)){console.error("缺少文件："+entry.path);bad++;continue}
      const hash=crypto.createHash("sha256").update(fs.readFileSync(entry.path)).digest("hex")
      if(hash!==entry.sha256){console.error("校验和不符："+entry.path);bad++}
    }
    if(bad){console.error("共 "+bad+" 个文件与部署清单不一致");process.exit(1)}
    console.log("清单内 "+manifest.files.length+" 个文件全部匹配")
  ' ) || die "部署包文件校验失败"
}

install_dependencies() {
  local release="$1"
  log "在设备上安装生产依赖（原生模块在此编译，不复制电脑产物）"
  # npm ci 按随包锁文件精确安装且不改写锁文件；npm install 会重写它，
  # 那样部署目录就跟 manifest 的 SHA-256 对不上，重复安装也无法自证完整。
  if ! ( cd "$release" && npm ci --omit=dev --no-audit --no-fund ); then
    warn "npm ci 失败，退回 npm install --no-package-lock（保持随包锁文件不被改写）"
    ( cd "$release" && npm install --omit=dev --no-package-lock --no-audit --no-fund ) || die "依赖安装失败"
  fi
  if ( cd "$release" && node scripts/sqlite-compat-check.mjs ); then
    return 0
  fi
  # npm 可能拦下安装脚本，better-sqlite3 就只有源码没有产物；显式重试一次本机编译，
  # 仍失败就停下，绝不改用别的数据库蒙过去。
  warn "驱动兼容性试验未通过，尝试在本机重新编译原生依赖"
  ( cd "$release" && npm rebuild better-sqlite3 --foreground-scripts ) || true
  ( cd "$release" && node scripts/sqlite-compat-check.mjs ) && return 0
  die "驱动兼容性试验仍未通过，停止安装。Termux 前置：pkg install make clang python3 binutils；随后在 $release 执行 npm rebuild better-sqlite3 --foreground-scripts"
}

do_install() {
  local source="${1:-}"
  [ -n "$source" ] || die "用法：hubctl install <package.tar.gz|目录>"
  apply_env_file
  require_dirs

  local work staging
  work="$(mktemp -d "${TMPDIR:-/tmp}/hub-install-XXXXXX")"
  if [ -d "$source" ]; then
    staging="$source"
  else
    [ -f "$source" ] || die "找不到部署包：$source"
    if [ -f "$source.sha256" ]; then
      ( cd "$(dirname "$source")" && node -e '
        const fs=require("fs"),crypto=require("crypto")
        const target=process.argv[1]
        const [line]=fs.readFileSync(target+".sha256","utf8").split("\n")
        const expected=(line||"").trim().split(/\s+/)[0]
        const actual=crypto.createHash("sha256").update(fs.readFileSync(target)).digest("hex")
        if(expected!==actual){console.error("部署包 sha256 不符：" + actual);process.exit(1)}
        console.log("部署包校验和一致")
      ' "$(basename "$source")" ) || die "部署包校验失败，拒绝安装"
    else
      warn "未提供 .sha256，跳过包级校验（manifest 仍会逐文件校验）"
    fi
    tar -xzf "$source" -C "$work" || die "解压失败"
    staging="$(ls -d "$work"/hub-* 2>/dev/null | head -n 1)"
    [ -n "$staging" ] || die "解压后找不到 hub-* 目录"
  fi

  if [ ! -f "$HUB_ENV_FILE" ]; then
    cat > "$HUB_ENV_FILE" <<EOF
# my-software-hub 手机侧配置（只放路径与开关，不要把密钥值写进来）
HOST=127.0.0.1
PORT=$PORT
HUB_DATA_DIR=$HUB_DATA_DIR
# HUB_ALLOWED_ORIGINS=http://192.168.1.10:8787
# HUB_RATE_LIMIT_PER_MIN=30
# HUB_MAX_BODY_BYTES=16384
# 审核/提交身份：指向 Termux 私有目录里的文件，权限 600
# HUB_REVIEWER_TOKEN_FILE=$HUB_HOME/secrets/reviewer.token
# HUB_SUBMITTER_TOKEN_FILE=$HUB_HOME/secrets/submitter.token
EOF
    log "已生成配置模板：$HUB_ENV_FILE（当前用默认值：HOST=127.0.0.1 PORT=$PORT）"
  fi

  local version
  version="$(node -e 'const fs=require("fs");const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));console.log(m.version)' "$staging/manifest.json")" || die "无法读取 manifest.version"
  local release="$RELEASES_DIR/hub-$version"

  if [ -e "$release" ] && [ "$source" != "$release" ]; then
    die "版本 ${version} 已存在于 ${release}，请换版本标识或先删除旧目录（不会自动覆盖在跑的版本）"
  fi

  local was_running=""
  if running_pid >/dev/null 2>&1; then was_running=1; do_stop; fi

  if [ ! -e "$release" ]; then
    mkdir -p "$RELEASES_DIR"
    cp -R "$staging" "$release"
  fi
  log "安装到 $release"
  verify_manifest "$release"
  install_dependencies "$release"
  verify_manifest "$release"

  if [ -f "$HUB_DATA_DIR/db/hub.sqlite" ]; then
    log "迁移前先备份"
    do_backup "--data-dir=$HUB_DATA_DIR" || die "备份失败，拒绝迁移"
  else
    log "首次安装：尚无数据库，跳过备份"
  fi

  # 在临时端口上跑一次"迁移 + 健康检查"，通过才切换 current
  local probe_port
  probe_port="$(node -e 'const s=require("net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')"
  log "以探测端口 ${probe_port} 预演迁移与健康检查"
  (
    cd "$release"
    HUB_DATA_DIR="$HUB_DATA_DIR" HUB_STATIC_DIR="$release/site" HUB_CONTENT_DIR="$release/runtime/data/generated" \
    HUB_SCHEMA_DIR="$release/schema" HUB_MIGRATIONS_DIR="$release/migrations" HUB_VERSION="$version" \
    HOST=127.0.0.1 PORT="$probe_port" nohup node "$release/api/index.js" >> "$HUB_DATA_DIR/logs/install-probe.log" 2>&1 &
    echo $! > "$HUB_DATA_DIR/run/probe.pid"
  )
  local probe_pid waited=0 ok=""
  probe_pid="$(cat "$HUB_DATA_DIR/run/probe.pid")"
  while [ "$waited" -lt 25 ]; do
    if health_ok "$probe_port"; then ok=1; break; fi
    sleep 1
    waited=$((waited + 1))
  done
  kill -TERM "$probe_pid" 2>/dev/null || true
  waited=0
  while kill -0 "$probe_pid" 2>/dev/null && [ "$waited" -lt 15 ]; do sleep 1; waited=$((waited + 1)); done
  rm -f "$HUB_DATA_DIR/run/probe.pid"
  [ -n "$ok" ] || { tail -n 30 "$HUB_DATA_DIR/logs/install-probe.log" >&2 || true; die "预演健康检查失败：保持原版本不切换（$(cat "$HUB_DATA_DIR/logs/install-probe.log" 2>/dev/null | tail -n 3)）"; }

  local previous
  previous="$(current_version 2>/dev/null || echo '')"
  ln -sfn "$release" "$CURRENT_LINK"
  if [ -n "$previous" ] && [ "$previous" != "$version" ]; then
    printf '%s\n' "$previous" >> "$HISTORY_FILE"
  fi
  printf '%s\n' "$version" > "$HUB_HOME/installed-version"
  log "✅ 已切换当前版本：hub-$version${previous:+（上一版本 hub-$previous）}"

  if [ -n "$was_running" ]; then
    do_start
  else
    log "服务原本未运行；执行 hubctl start 启动"
  fi
  [ -d "$work" ] && rm -rf "$work"
}

do_backup() {
  apply_env_file
  local release out=""
  release="$(current_dir || true)"
  [ -n "$release" ] || die "尚未安装部署包"
  local args=("--data-dir" "$HUB_DATA_DIR")
  for extra in "$@"; do
    case "$extra" in
      --out=*) out="${extra#--out=}" ;;
      --data-dir=*) args=("--data-dir" "${extra#--data-dir=}") ;;
    esac
  done
  [ -n "$out" ] && args+=("--out" "$out")
  node "$release/scripts/hub-db.mjs" backup "${args[@]}"
}

do_restore() {
  apply_env_file
  local release was_running=""
  release="$(current_dir || true)"
  [ -n "$release" ] || die "尚未安装部署包"
  if running_pid >/dev/null 2>&1; then
    log "恢复前先停止服务"
    do_stop
    was_running=1
  fi
  if ! node "$release/scripts/hub-db.mjs" restore --data-dir "$HUB_DATA_DIR" --migrations "$release/migrations" "$@"; then
    # 校验没过就退回原状态，别让一次被拒的 restore 把服务停在那儿
    if [ -n "$was_running" ]; then
      warn "恢复未完成，重新拉起原服务"
      do_start
    fi
    die "恢复未完成（校验或迁移不兼容），已保持原数据库与版本"
  fi
  log "恢复完成，重启服务"
  do_start
}

do_rollback() {
  apply_env_file
  local target="${1:-}"
  [ -L "$CURRENT_LINK" ] || die "尚未安装任何部署包"
  local from
  from="$(current_version)"
  if [ -z "$target" ]; then
    [ -f "$HISTORY_FILE" ] || die "没有可回退的历史版本（release-history 为空）"
    target="$(tail -n 1 "$HISTORY_FILE")"
  fi
  local release="$RELEASES_DIR/hub-$target"
  [ -d "$release" ] || die "找不到目标版本目录：$release"
  verify_manifest "$release"

  local current_migrations target_migrations
  current_migrations="$(node -e 'const fs=require("fs");console.log(JSON.parse(fs.readFileSync(process.argv[1],"utf8")).migrations.tags.length)' "$RELEASES_DIR/hub-$from/manifest.json" 2>/dev/null || echo 0)"
  target_migrations="$(node -e 'const fs=require("fs");console.log(JSON.parse(fs.readFileSync(process.argv[1],"utf8")).migrations.tags.length)' "$release/manifest.json")"
  if [ "${target_migrations:-0}" -lt "${current_migrations:-0}" ]; then
    die "回退目标只有 ${target_migrations} 个迁移，当前代码/数据库已应用 ${current_migrations} 个：拒绝降级数据库。
可选恢复步骤：
  1) hubctl backup                     # 先保住现在的库
  2) 安装含这些迁移的部署包（保持数据库不动）
  3) 如确需回到旧库：hubctl restore --from <升级前备份文件>"
  fi

  if running_pid >/dev/null 2>&1; then do_stop; fi
  ln -sfn "$release" "$CURRENT_LINK"
  # 从历史里摘掉刚被回退掉的版本，避免下一次 rollback 又跳回来
  if [ -f "$HISTORY_FILE" ]; then
    grep -v "^${from}\$" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" || true
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi
  printf '%s\n' "$target" > "$HUB_HOME/installed-version"
  log "✅ 已回退：hub-$from → hub-$target"
  do_start
  log "内容 revision 核对："
  node -e '
    const port=process.argv[1]
    fetch(`http://127.0.0.1:${port}/health`).then((r)=>r.json()).then((body)=>{
      console.log("   version=" + body.version + " 数据库=" + (body.database.ok?"ok":"异常") + " 迁移=" + body.database.migrationsApplied)
      for (const item of body.contentProducts) console.log("   " + item.id + " → " + (item.revision ?? "无副本"))
    }).catch(()=>{console.error("   健康检查失败")})
  ' "$PORT"
}

do_status() {
  apply_env_file
  local version pid
  version="$(current_version 2>/dev/null || echo '未安装')"
  printf '版本    : %s\n' "$version"
  printf '监听    : %s:%s（局域网访问需显式设 HOST=0.0.0.0）\n' "$HOST" "$PORT"
  printf '数据目录: %s\n' "$HUB_DATA_DIR"
  printf '日志    : %s\n' "$LOG_FILE"
  if pid="$(running_pid)"; then
    printf '进程    : 运行中 pid=%s\n' "$pid"
    if health_ok; then
      printf '健康    : ok\n'
      node -e '
        const port=process.argv[1]
        fetch(`http://127.0.0.1:${port}/health`).then((r)=>r.json()).then((body)=>{
          console.log("          node=" + body.node + " 运行时长=" + body.uptimeSeconds + "s 迁移=" + body.database.migrationsApplied)
          for (const item of body.contentProducts) console.log("          " + item.id + " → " + (item.revision ?? "无副本"))
        })
      ' "$PORT"
    else
      printf '健康    : 异常（端口无响应或 status≠ok）\n'
    fi
  else
    printf '进程    : 未运行\n'
  fi
  if [ -f "$HUB_DATA_DIR/db/hub.sqlite" ]; then
    local release
    release="$(current_dir || true)"
    [ -n "$release" ] && node "$release/scripts/hub-db.mjs" stats --data-dir "$HUB_DATA_DIR" --plain | head -c 400
    printf '\n'
  fi
  local backups
  backups="$(ls -1t "$HUB_DATA_DIR/backups"/*.sqlite 2>/dev/null | head -n 3 || true)"
  if [ -n "$backups" ]; then
    printf '最近备份:\n'
    printf '%s\n' "$backups" | sed 's/^/  /'
  else
    printf '最近备份: 无（执行 hubctl backup）\n'
  fi
}

do_logs() {
  apply_env_file
  local lines=50
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n) lines="${2:-50}"; shift 2 ;;
      -n=*) lines="${1#-n=}"; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$LOG_FILE" ] || die "还没有日志文件：$LOG_FILE"
  tail -n "$lines" "$LOG_FILE"
}

do_doctor() {
  apply_env_file
  printf '设备  : %s %s（node=%s）\n' "$(uname -s)" "$(uname -m)" "$(node -v 2>/dev/null || echo 缺失)"
  df -h "$HUB_HOME" 2>/dev/null | tail -n 1 | awk '{printf "存储  : 已用 %s / 可用 %s（%s）\n", $3, $4, $2}'
  [ -f "$HUB_ENV_FILE" ] && printf '配置  : %s\n' "$HUB_ENV_FILE" || warn "没有 $HUB_ENV_FILE，使用默认值"
  local release
  release="$(current_dir 2>/dev/null || true)"
  if [ -n "$release" ]; then
    printf '部署  : %s\n' "$release"
    [ -d "$release/node_modules" ] && printf '依赖  : 已安装\n' || warn "依赖未安装：在 $release 执行 npm install --omit=dev"
    node "$release/scripts/sqlite-compat-check.mjs" >/dev/null 2>&1 && printf '驱动  : 兼容\n' || warn "驱动兼容性试验未通过，见 hubctl logs"
  else
    warn "尚未安装部署包"
  fi
  [ -f "$HUB_DATA_DIR/db/hub.sqlite" ] && printf '数据库: %s\n' "$HUB_DATA_DIR/db/hub.sqlite" || warn "还没有数据库文件"
  printf '防火墙: Termux 无需端口放行，但 Android 休眠会终止进程（见 ANDROID-DEPLOY.md）\n'
}

do_env() {
  apply_env_file
  cat <<EOF
HUB_HOME=$HUB_HOME
HUB_DATA_DIR=$HUB_DATA_DIR
HOST=$HOST
PORT=$PORT
HUB_STATIC_DIR=<release>/site
HUB_CONTENT_DIR=<release>/runtime/data/generated
HUB_SCHEMA_DIR=<release>/schema
HUB_MIGRATIONS_DIR=<release>/migrations
HUB_ALLOWED_ORIGINS=${HUB_ALLOWED_ORIGINS:-（同源）}
HUB_RATE_LIMIT_PER_MIN=${HUB_RATE_LIMIT_PER_MIN:-30}
HUB_MAX_BODY_BYTES=${HUB_MAX_BODY_BYTES:-16384}
凭证只以文件形式给出路径，不打印内容：
HUB_REVIEWER_TOKEN_FILE=${HUB_REVIEWER_TOKEN_FILE:-（未配置）}
HUB_SUBMITTER_TOKEN_FILE=${HUB_SUBMITTER_TOKEN_FILE:-（未配置）}
EOF
}

command="${1:-}"
[ "$#" -gt 0 ] && shift || true
apply_env_file
case "$command" in
  install) do_install "${1:-}" ;;
  start) do_start ;;
  stop) do_stop ;;
  restart) do_stop; do_start ;;
  status) do_status ;;
  logs) do_logs "$@" ;;
  backup) do_backup "$@" ;;
  restore) do_restore "$@" ;;
  rollback) do_rollback "${1:-}" ;;
  doctor) do_doctor ;;
  env) do_env ;;
  "" | help | --help | -h) usage ;;
  *) usage; die "未知命令：$command" ;;
esac
